{
  "compilerOptions": {
    "target": "ES2020",                 // 或 "ESNext"
    "module": "ESNext",                  // 必须设置为支持 import.meta 的值
    "moduleResolution": "Node",          // 解析模块的方式，通常配合使用
    "allowSyntheticDefaultImports": true, // 允许默认导入
    "esModuleInterop": true,              // 增强与 CommonJS 的互操作性
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"],
  "exclude": ["node_modules"]
}