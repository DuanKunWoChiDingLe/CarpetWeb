# Development uses Vite's /api proxy, so the default should stay /api.
VITE_API_BASE_URL=/api
# Render/static hosting: backend public origin without /api (for example https://carpetweb-api.onrender.com).
# VITE_API_ORIGIN=https://carpetweb-api.onrender.com
# Set only when images are served from a different origin than the frontend.
# VITE_ASSET_BASE_URL=https://example.com
# Override the backend target used by Vite's /api, /uploads and /ws proxy.
# VITE_PROXY_TARGET=http://127.0.0.1:8080

